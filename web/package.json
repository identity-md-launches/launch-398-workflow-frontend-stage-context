{
  "name": "lab-daemon-sponsor-web",
  "private": true,
  "version": "1.0.0",
  "description": "Static one-page frontend for the DaemonSponsorPool (SPON) Sepolia deployment",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:abi-types": "node scripts/gen-abi-types.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "npm run gen:abi-types && npm run typecheck && vite build && node scripts/build-manifest.mjs",
    "manifest": "node scripts/build-manifest.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run verify:dist"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.9",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "^26.1.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
